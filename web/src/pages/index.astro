---
import Footer from "@components/microsite/Footer.astro";
import MicrositePage from "@components/microsite/microsite-page";
import BaseLayout from "@layouts/BaseLayout.astro";

import { loadMicrosite, siteMeta } from "@/lib/contents";

const site = await loadMicrosite();
---

<BaseLayout title={siteMeta.title} description={siteMeta.description} heroImage={siteMeta.shareImage()}>
	<MicrositePage client:load site={site} />
	<Footer name={site.name} footer={site.footer} />
</BaseLayout>
