---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="Error 404 page not found." noindex={true}>
	<section class="mx-auto max-w-xl px-4 pt-36 text-center md:pt-44">
		<h1 class="text-4xl font-bold">Página no encontrada</h1>
		<p class="mt-4 text-muted-foreground">
			Disculpas, la página buscada no se encuentra disponible. Volvé a la página principal.
		</p>
		<a
			href="/"
			class="mt-8 inline-flex h-11 items-center rounded-md bg-primary px-6 text-primary-foreground"
		>
			Ir al inicio
		</a>
	</section>
</BaseLayout>
