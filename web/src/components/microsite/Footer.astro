---
import horizonte from "@assets/horizonte.svg";

import type { Footer } from "@/lib/types";

interface Props {
	name: string;
	footer: Footer;
}

const { name, footer } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
	<img
		src={horizonte.src}
		alt=""
		width={horizonte.width}
		height={horizonte.height}
		class="block h-16 w-full md:h-24"
	/>
	<div class="bg-primary text-primary-foreground">
		<div
			class="mx-auto flex max-w-7xl flex-col gap-8 px-4 pt-8 pb-28 sm:px-6 md:flex-row md:items-end md:justify-between md:py-12 lg:px-8"
		>
			<div class="flex flex-col gap-5">
				<div class="flex items-center gap-3 text-2xl font-semibold">
					<img src={footer.logo_url} alt="" width="96" height="96" class="size-24" />
					{name}
				</div>
				<p class="max-w-160 text-4xl leading-[1.1] font-bold tracking-[-1px] text-brand-accent md:text-5xl">
					{footer.slogan}
				</p>
			</div>
			<div class="flex flex-col gap-2 md:items-end">
				{
					footer.links.map((link) => (
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="text-base underline">
							{link.label}
						</a>
					))
				}
				<p class="text-sm">© {year} {name}</p>
			</div>
		</div>
	</div>
</footer>
