---
import "@/styles/global.css";

import BaseHead from "@layouts/BaseHead.astro";

interface Props {
	type?: "general";
	title: string;
	description: string;
	heroImage?: ImageMetadata;
	noindex?: boolean; // you need to opt-in to no indexing, as it hides the page from search engines
}

const { type = "general", title, description, heroImage, noindex = false } = Astro.props as Props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead type={type} title={title} description={description} image={heroImage} noindex={noindex} />
	</head>
	<body>
		<slot />
	</body>
</html>
